        "ollama_title": "Modelos locales (opcional)",
        "ollama_text": "Ollama ejecuta modelos de IA en tu equipo. Cada modelo ocupa varios GB.",
        "ollama": "Instalar Ollama",
        "lang_title": "Idioma y teclado",
        "lang_text": "Español (Perú) con teclado latinoamericano. Alt+Mayús cambia la distribución.",
        "lang": "Switch to English",
        "lang_confirm": "Se reiniciará la sesión para aplicar el idioma. Guarda tu trabajo antes de seguir.",
        "show": "Mostrar esta bienvenida al iniciar sesión",
