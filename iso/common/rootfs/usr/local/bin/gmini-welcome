#!/usr/bin/env python3
"""Pantalla de bienvenida de G-Mini OS.

Se abre al iniciar sesión (autostart con --autostart) y desde el lanzador
"Bienvenida". Explica el primer arranque de G-Mini Agent y da acceso a la red,
la instalación en disco, Ollama y el cambio de idioma.
"""

from __future__ import annotations

import configparser
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GdkPixbuf, Gtk  # noqa: E402

LOGO = "/usr/local/share/icons/hicolor/scalable/apps/gmini-os.svg"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "gmini" / "welcome.ini"

TEXTS = {
    "es": {
        "title": "Bienvenido a G-Mini OS",
